# Ghostty is the only entry point to the new setup: it launches zsh with
# ZDOTDIR pointing at the parallel config. iTerm2 keeps using ~/.zshrc.
command = /usr/bin/env ZDOTDIR=/Users/marcel/.config/zsh /bin/zsh --login

theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 13

# Left Option is Meta (word editing, alt-d, alt-. etc.); right Option keeps
# dead keys for special characters. Cmd gets mac-style line editing.
macos-option-as-alt = left
# No alt+backspace keybind here on purpose: apps using the kitty keyboard
# protocol (e.g. Claude Code) must receive the real key; zsh handles the
# option-as-alt ESC+DEL natively.
keybind = cmd+backspace=text:\x15
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
